{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_scope_note": "Project-local to THIS repository only (single-project scope per Claude Code's documented settings precedence: .claude/settings.json applies to sessions rooted in this exact directory tree, not globally). Do not copy this file's hook wiring into any global/user-level Claude Code config.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/pre_tool_use_guard.js\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/pre_tool_use_guard.js\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/pre_tool_use_guard.js\""
          }
        ]
      }
    ]
  }
}
